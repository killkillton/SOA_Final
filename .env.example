# =============================================================================
# Hotel Booking Microservices - Environment Configuration Example
# Copy this file to `.env` before running `docker compose up -d`.
# =============================================================================

# --- PostgreSQL (1 container hosting 6 logical databases) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Logical database names (Database-per-Service pattern)
AUTH_DB_NAME=auth_db
ROOM_INVENTORY_DB_NAME=room_inventory_db
RESERVATION_DB_NAME=reservation_db
PAYMENT_DB_NAME=payment_db
STAY_DB_NAME=stay_db
NOTIFICATION_DB_NAME=notification_db

# --- Redis (Distributed Locks, OTPs, Idempotency Keys, Search/Rate Cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ (Async Event Bus, 15m Booking Delay Queue, Email Work Queue) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- External Integrations (Configured in later steps) ---
# Firebase Auth (login & ID token verification only)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# SMTP Mail Server (used by notification-service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
